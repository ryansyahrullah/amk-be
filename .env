# File: .env.example
# ---------------------------------------------------------
# Contoh konfigurasi environment untuk aplikasi AMK-BE.
# File ini boleh di-commit ke Git, tapi .env (tanpa .example) JANGAN di-commit.
# Copy file ini menjadi .env, lalu isi nilai sesuai environment kamu.

APP_PORT=8080
# Nilai ini dipakai loader konfigurasi untuk menampilkan log tambahan.
APP_ENV=local

# ========================
# Konfigurasi database
# ========================
# Ketika menjalankan API langsung dari host (tanpa Docker) pastikan MySQL
# bisa diakses lewat localhost. Gunakan docker compose (lihat README) agar
# service `db` tetap berjalan di port 3306 host Anda.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=amk_db

# Jika kelak API ikut dijalankan lewat docker compose, override env ini
# menjadi `db` di file `.env.docker` atau pada service container Anda.
# DB_HOST=db

JWT_SECRET=isi-dengan-secret-jwt-yang-kuat

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@amk.local
