# Contoh konfigurasi environment untuk aplikasi AMK-BE.
# File ini boleh di-commit ke Git, tapi .env (tanpa .example) JANGAN di-commit.
# Copy file ini menjadi .env, lalu isi nilai sesuai environment kamu.

APP_PORT=8080
APP_ENV=local

DB_HOST=db
DB_PORT=3306
DB_USER=amk
DB_PASS=amk123
DB_NAME=amk_db

JWT_SECRET=isi-dengan-secret-jwt-yang-kuat

SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@amk.local
